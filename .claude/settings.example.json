{
  "//": "agent-findings hook registration. install.sh merges this into your ~/.claude/settings.json automatically. Hooks live in ~/.agent-findings/hooks/ — a neutral location shared by both Claude Code and Codex. If you prefer to wire it by hand, copy the hook entries below into your existing settings.json (merge, do not overwrite).",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.agent-findings/hooks/findings-session-init.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.agent-findings/hooks/findings-writer.sh"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.agent-findings/hooks/findings-reader.sh"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.agent-findings/hooks/findings-exit-guard.sh"
          }
        ]
      }
    ]
  }
}
